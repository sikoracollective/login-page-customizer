<?xml version="1.0"?>
<phpunit
	bootstrap="bootstrap.php"
	backupGlobals="false"
	colors="true"
	convertErrorsToExceptions="true"
	convertNoticesToExceptions="true"
	convertWarningsToExceptions="true"
	printerClass="Sikora_Login_Result_Printer"
	>
	<testsuites>
		<testsuite name="login-page-customizer">
			<directory suffix=".php">./unit</directory>
		</testsuite>
	</testsuites>
	<listeners>
		<listener class="Sikora_Login_Test_Logger" file="includes/class-sikora-login-test-logger.php" />
	</listeners>
</phpunit>
